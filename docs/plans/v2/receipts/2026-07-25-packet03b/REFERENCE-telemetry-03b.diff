+class TracingFastMCP(FastMCP):
+    """A :class:`FastMCP` that writes ONE ``trace`` row per served tool call.
+
+    The seam (03b T1): ``mcp==1.27.2`` exposes no middleware/hook API, and
+    ``FastMCP.call_tool`` is the SINGLE funnel every dispatch rides (the lowlevel
+    server registers the BOUND method once, in ``_setup_handlers``). Overriding it
+    gives coverage BY CONSTRUCTION — built-in tools, extension-registered tools,
+    and any tool registered in the future — instead of ~20 hand-placed emission
+    call sites, each a forgettable obligation invisible for any tool added later.
+    """
+
+    #: The exactly-three argument keys the emission harvests as DECLARED identity
+    #: (T4.1). A KEY rule, never a tool-name rule: no enumeration exists to go
+    #: stale, any current or future tool declaring ``agent=`` is captured, and a
+    #: tool declaring none is honestly NONE. Heterogeneous ledger-actor params
+    #: (``actor``/``owner``/``created_by``) are deliberately NOT harvested.
+    _DECLARED_IDENTITY_KEYS = ("agent", "session", "action")
+    #: The transport correlator header (streamable-http). Recorded as a
+    #: CORRELATOR, never as an identity.
+    _TRANSPORT_SESSION_HEADER = "mcp-session-id"
+
+    async def call_tool(
+        self, name: str, arguments: dict[str, Any]
+    ) -> Sequence[Any] | dict[str, Any]:
+        """Dispatch through ``super()`` and emit one trace row, whatever happens.
+
+        The SUCCESS LATCH (T5 / ESC-1): ``ok`` starts False and is latched True
+        ONLY after the dispatch RETURNS — there is no ``except`` arm at all, so
+        ANY raise (a tool error, a ``CancelledError``, anything) leaves
+        ``ok=False`` with nothing caught and nothing re-raised. Allowlist the
+        success state; never enumerate failure classes. The write sits in
+        ``finally`` (load-bearing, AC-06-probed: an awaited write in ``finally``
+        COMPLETES when the surrounding task is cancelled, so the cancelled
+        population — a struggling session's timed-out calls — is recorded).
+        """
+        started = time.perf_counter()
+        ok = False
+        try:
+            result = await super().call_tool(name, arguments)
+            ok = True
+            return result
+        finally:
+            latency_ms = (time.perf_counter() - started) * 1000.0
+            try:
+                await self._emit_trace(
+                    tool=name, arguments=arguments, latency_ms=latency_ms, ok=ok
+                )
+            except Exception:
+                # The tool call's outcome ALWAYS wins (T5.1): a telemetry write
+                # never converts a served call into an error. The failure is LOUD
+                # where it can be — the server log — and visible in the flatlined
+                # ``traces`` section lore_index serves.
+                logger.exception("trace.emit.failed", extra={"tool": name})
+
+    async def _emit_trace(
+        self, *, tool: str, arguments: dict[str, Any], latency_ms: float, ok: bool
+    ) -> None:
+        """Write the row: declared identity + transport correlator, never a guess."""
+        request_context = self._request_context()
+        if request_context is None:
+            # No request in flight (a direct in-process dispatch outside a
+            # session): there is no lifespan context to reach a store through.
+            # Degrade honestly — skip, exactly like an absent transport header.
+            return
+        app_context: AppContext = request_context.lifespan_context
+        declared = self._declared_identity(arguments)
+        await app_context.write_store.record_trace(
+            tool=tool,
+            params_hash=self._params_hash(arguments),
+            latency_ms=latency_ms,
+            ok=ok,
+            agent=declared["agent"],
+            session=declared["session"],
+            action=declared["action"],
+            transport_session=self._transport_session(request_context),
+        )
+
+    def _request_context(self) -> Any | None:
+        """The in-flight request context, or ``None`` outside a request."""
+        try:
+            return self._mcp_server.request_context
+        except LookupError:
+            return None
+
+    def _declared_identity(self, arguments: dict[str, Any]) -> dict[str, str | None]:
+        """Harvest the three declared identity keys — a value is kept iff it is a ``str``."""
+        declared: dict[str, str | None] = {}
+        for key in self._DECLARED_IDENTITY_KEYS:
+            value = arguments.get(key)
+            declared[key] = value if isinstance(value, str) else None
+        return declared
+
+    def _transport_session(self, request_context: Any) -> str | None:
+        """The ``mcp-session-id`` header when the transport exposes one, else NONE."""
+        request = getattr(request_context, "request", None)
+        headers = getattr(request, "headers", None)
+        if headers is None:
+            return None
+        value = headers.get(self._TRANSPORT_SESSION_HEADER)
+        return value if isinstance(value, str) else None
+
+    @staticmethod
+    def _params_hash(arguments: dict[str, Any]) -> str:
+        """The stable digest of a call's raw arguments (T6).
+
+        Deterministic (same args ⇒ same hash) and content-free: bodies, briefs and
+        every other raw parameter pass through the hash only — nothing raw is
+        stored.
+        """
+        encoded = json.dumps(arguments, sort_keys=True, default=str).encode()
+        return hashlib.sha256(encoded).hexdigest()
+
+
 def build_mcp_server(server: LoreServer) -> Any:
     """Construct the FastMCP server: lifespan + the built-in tools + extension tools.
 
@@ -6666,7 +6779,7 @@ def build_mcp_server(server: LoreServer) -> Any:
